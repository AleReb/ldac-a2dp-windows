<Window x:Class="LdacConfig.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LdacConfig"
        Title="LDAC A2DP Driver Configuration"
        Width="1160" Height="1000" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <local:EnumEqualsConverter x:Key="EnumEquals" />
        <local:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===== Navigation ===== -->
        <DockPanel Grid.Column="0" Background="{StaticResource NavBackground}">
            <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,12">
                <Button Style="{StaticResource NavLink}" Click="OnRefresh">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE72C;" FontSize="16" Margin="0,0,14,0" VerticalAlignment="Center" />
                        <TextBlock Text="Refresh list" FontSize="16" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource NavLink}" Click="OnAbout">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE946;" FontSize="16" Margin="0,0,14,0" VerticalAlignment="Center" />
                        <TextBlock Text="About" FontSize="16" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource NavLink}" Click="OnFaq">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE897;" FontSize="16" Margin="0,0,14,0" VerticalAlignment="Center" />
                        <TextBlock Text="FAQ" FontSize="16" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <StackPanel DockPanel.Dock="Top">
                <TextBlock Text="Bluetooth stereo audio devices (A2DP)" FontSize="16" FontWeight="SemiBold"
                           Margin="14,24,14,12" TextWrapping="Wrap" />
                <TextBlock Text="Searching for paired devices…" Margin="20,8" Foreground="{StaticResource SecondaryText}"
                           Visibility="{Binding Loading, Converter={StaticResource BoolToVis}}" />
                <TextBlock Margin="20,8" TextWrapping="Wrap" Foreground="{StaticResource SecondaryText}"
                           Visibility="{Binding NoDevices, Converter={StaticResource BoolToVis}}"
                           Text="Pair your headphones in Settings → Bluetooth &amp; devices, then select Refresh list." />
            </StackPanel>

            <ListBox ItemsSource="{Binding Devices}" SelectedItem="{Binding Selected}"
                     Background="Transparent" BorderThickness="0" Margin="4,0">
                <!-- Windows 11 navigation look: subtle fill plus an accent bar on the left -->
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Margin="2,1">
                                        <Grid>
                                            <Border x:Name="Bar" Width="3" Height="18" CornerRadius="1.5" HorizontalAlignment="Left"
                                                    Background="{DynamicResource AccentFillColorDefaultBrush}" Visibility="Collapsed" />
                                            <ContentPresenter Margin="12,4" />
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#2D2D2D" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#2D2D2D" />
                                            <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="4,6">
                            <TextBlock Text="{Binding Name}" FontSize="16" />
                            <TextBlock Text="Connected" FontSize="12" Foreground="{StaticResource SecondaryText}"
                                       Visibility="{Binding Connected, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- ===== Pages ===== -->
        <Grid Grid.Column="1" Background="{StaticResource PageBackground}">

            <!-- Device settings -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding ShowDevice, Converter={StaticResource BoolToVis}}">
                <StackPanel Margin="20,16,24,24" MaxWidth="720" HorizontalAlignment="Left"
                            DataContext="{Binding Selected}"
                            IsEnabled="{Binding DataContext.HasDevice, RelativeSource={RelativeSource AncestorType=Window}}">

                    <TextBlock Text="Device settings" FontSize="28" Margin="0,8,0,8" />
                    <TextBlock Text="{Binding AddressText, StringFormat='Address: {0}'}" Foreground="{StaticResource SecondaryText}" />

                    <TextBlock Style="{StaticResource FieldLabel}" Text="Device driver" />
                    <StackPanel Orientation="Horizontal">
                        <ComboBox Width="280" SelectedValuePath="Tag" SelectedValue="{Binding Settings.Driver}">
                            <ComboBoxItem Content="LDAC A2DP Driver" Tag="{x:Static local:DriverChoice.Ldac}" />
                            <ComboBoxItem Content="Microsoft Bluetooth audio driver" Tag="{x:Static local:DriverChoice.Microsoft}" />
                        </ComboBox>
                        <Button Content="Install" Margin="40,0,0,0" IsEnabled="False"
                                ToolTipService.ShowOnDisabled="True"
                                ToolTip="Run install.cmd to install the driver. To restore the Microsoft driver, open Settings → Apps, select LDAC A2DP and choose Uninstall." />
                    </StackPanel>

                    <TextBlock Style="{StaticResource SectionHeader}" Text="Codec settings" />
                    <StackPanel Orientation="Horizontal">
                        <StackPanel>
                            <TextBlock Text="Codec" FontSize="14" Margin="0,0,0,6" />
                            <ComboBox Width="200" SelectedValuePath="Tag" SelectedValue="{Binding Settings.Codec}">
                                <ComboBoxItem Content="LDAC" Tag="{x:Static local:CodecType.LDAC}" />
                                <ComboBoxItem Content="SBC" Tag="{x:Static local:CodecType.SBC}" />
                            </ComboBox>
                        </StackPanel>
                        <TextBlock Style="{StaticResource InfoIcon}" VerticalAlignment="Top" Margin="10,2,0,0">
                            <TextBlock.ToolTip>
                                <TextBlock MaxWidth="360" TextWrapping="Wrap"
                                           Text="LDAC supports up to 990 kbps and 96 kHz at 24 bits. SBC is the standard A2DP fallback when the headphones decline LDAC." />
                            </TextBlock.ToolTip>
                        </TextBlock>
                        <Button Margin="40,0,0,0" Width="440" VerticalAlignment="Stretch" Padding="12,8" HorizontalContentAlignment="Left"
                                Click="OnPreset">
                            <TextBlock TextWrapping="Wrap" Text="Load defaults for this codec" />
                        </Button>
                    </StackPanel>

                    <TextBlock Style="{StaticResource FieldLabel}" Margin="0,28,0,6"
                               Text="Allowed channel modes" />
                    <StackPanel Orientation="Horizontal">
                        <CheckBox Style="{StaticResource OptionCheck}" Content="Mono" IsChecked="{Binding Settings.AllowMono}" />
                        <CheckBox Style="{StaticResource OptionCheck}" Content="Stereo" IsChecked="{Binding Settings.AllowStereo}" />
                    </StackPanel>

                    <TextBlock Style="{StaticResource FieldLabel}" Text="Allowed sample rates" />
                    <StackPanel Orientation="Horizontal">
                        <CheckBox Style="{StaticResource OptionCheck}" Content="44.1 kHz" IsChecked="{Binding Settings.Rate44}" />
                        <CheckBox Style="{StaticResource OptionCheck}" Content="48 kHz" IsChecked="{Binding Settings.Rate48}" />
                        <CheckBox Style="{StaticResource OptionCheck}" Content="88.2 kHz" IsChecked="{Binding Settings.Rate88}"
                                  Visibility="{Binding Settings.IsLdac, Converter={StaticResource BoolToVis}}" />
                        <CheckBox Style="{StaticResource OptionCheck}" Content="96 kHz" IsChecked="{Binding Settings.Rate96}"
                                  Visibility="{Binding Settings.IsLdac, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>

                    <TextBlock Style="{StaticResource FieldLabel}" Text="Allowed bit depths" />
                    <StackPanel Orientation="Horizontal">
                        <CheckBox Style="{StaticResource OptionCheck}" Content="16-bit" IsChecked="{Binding Settings.Bits16}" />
                        <CheckBox Style="{StaticResource OptionCheck}" Content="24-bit" IsChecked="{Binding Settings.Bits24}" />
                    </StackPanel>

                    <TextBlock Style="{StaticResource FieldLabel}" Text="Stereo mode" />
                    <ComboBox Width="280" HorizontalAlignment="Left"
                              ItemsSource="{Binding Settings.ChannelModes}" SelectedItem="{Binding Settings.ChannelMode}" />

                    <Button Content="Reconnect device" HorizontalAlignment="Right" Margin="0,16,0,0"
                            Padding="14,8" Click="OnReconnect" />
                    <TextBlock Margin="0,20,0,0" TextWrapping="Wrap" Foreground="{StaticResource SecondaryText}"
                               Text="{Binding DataContext.Message, RelativeSource={RelativeSource AncestorType=Window}}" />

                    <StackPanel Visibility="{Binding Settings.IsLdac, Converter={StaticResource BoolToVis}}">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Encoding quality" />
                        <StackPanel Orientation="Horizontal">
                            <RadioButton GroupName="q" Content="MQ (low)" MinWidth="150"
                                         IsChecked="{Binding Settings.Quality, Converter={StaticResource EnumEquals}, ConverterParameter=MQ}" />
                            <RadioButton GroupName="q" Content="SQ (medium)" MinWidth="150"
                                         IsChecked="{Binding Settings.Quality, Converter={StaticResource EnumEquals}, ConverterParameter=SQ}" />
                            <RadioButton GroupName="q" Content="HQ (high)" MinWidth="140"
                                         IsChecked="{Binding Settings.Quality, Converter={StaticResource EnumEquals}, ConverterParameter=HQ}" />
                            <TextBlock Style="{StaticResource InfoIcon}">
                                <TextBlock.ToolTip>
                                    <TextBlock MaxWidth="360" TextWrapping="Wrap"
                                               Text="MQ uses 330 kbps, SQ 660 kbps and HQ 990 kbps (303, 606 and 909 kbps at 44.1 or 88.2 kHz). Interference can interrupt playback at HQ." />
                                </TextBlock.ToolTip>
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <CheckBox Content="Automatically reduce quality when the Bluetooth signal is weak"
                                      IsChecked="{Binding Settings.Adaptive}" />
                            <TextBlock Style="{StaticResource InfoIcon}">
                                <TextBlock.ToolTip>
                                    <TextBlock MaxWidth="360" TextWrapping="Wrap"
                                               Text="Adaptive bitrate uses the transmit queue to lower quality from HQ through SQ, 492 and 396 kbps to MQ. Quality increases again after about six seconds of a stable connection." />
                                </TextBlock.ToolTip>
                            </TextBlock>
                        </StackPanel>
                        <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{StaticResource SecondaryText}"
                                   Text="Quality changes take effect with the next audio packet." />
                    </StackPanel>

                    <TextBlock Style="{StaticResource FieldLabel}" Text="Keep streaming after audio stops" />
                    <StackPanel Orientation="Horizontal">
                        <ComboBox Width="140" ItemsSource="{Binding Settings.HoldChoices}" SelectedItem="{Binding Settings.HoldSeconds}"
                                  ItemStringFormat="{}{0} s" />
                        <TextBlock Style="{StaticResource InfoIcon}">
                            <TextBlock.ToolTip>
                                <TextBlock MaxWidth="380" TextWrapping="Wrap"
                                           Text="Headphones can take about a second to resume after a pause. Keeping the stream open preserves the start of short sounds such as notifications. Longer delays transmit silence for longer." />
                            </TextBlock.ToolTip>
                        </TextBlock>
                    </StackPanel>

                    <TextBlock Style="{StaticResource SectionHeader}" Text="Live status" Margin="0,32,0,12" />
                    <Grid DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="240" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                            <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Active codec" Margin="0,3" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding StatusCodec}" Margin="0,3" />
                        <TextBlock Grid.Row="1" Text="Channel mode" Margin="0,3" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding StatusChannelMode}" Margin="0,3" />
                        <TextBlock Grid.Row="2" Text="Sample rate" Margin="0,3" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding StatusSampleRate}" Margin="0,3" />
                        <TextBlock Grid.Row="3" Text="Bit depth" Margin="0,3" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding StatusBitDepth}" Margin="0,3" />
                        <TextBlock Grid.Row="4" Text="Bitrate" Margin="0,3" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding StatusBitrate}" Margin="0,3" />
                        <TextBlock Grid.Row="5" Text="Streaming" Margin="0,3" />
                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding StatusStreaming}" Margin="0,3" />
                        <TextBlock Grid.Row="6" Text="Current quality" Margin="0,3" />
                        <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding StatusQuality}" Margin="0,3" />
                        <TextBlock Grid.Row="7" Text="Volume" Margin="0,3" />
                        <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding StatusVolume}" Margin="0,3" />
                        <TextBlock Grid.Row="8" Text="AVRCP (volume and buttons)" Margin="0,3" />
                        <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding StatusAvrcp}" Margin="0,3" />
                        <TextBlock Grid.Row="9" Text="Dropped packets" Margin="0,3" />
                        <TextBlock Grid.Row="9" Grid.Column="1" Text="{Binding StatusDropped}" Margin="0,3" />
                        <TextBlock Grid.Row="10" Text="Encoder service" Margin="0,3" />
                        <TextBlock Grid.Row="10" Grid.Column="1" Text="{Binding ServiceState}" Margin="0,3" />
                        <TextBlock Grid.Row="11" Grid.ColumnSpan="2" Margin="0,8,0,0" TextWrapping="Wrap"
                                   Foreground="{StaticResource SecondaryText}"
                                   Text="Live status is unavailable. Check that the headphones are connected, use this driver and that the encoder service is running."
                                   Visibility="{Binding HasStatus, Converter={StaticResource InverseBoolToVis}}" />
                    </Grid>


                </StackPanel>
            </ScrollViewer>

            <!-- About -->
            <StackPanel Margin="20,24" MaxWidth="720" HorizontalAlignment="Left"
                        Visibility="{Binding ShowAbout, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="About" FontSize="28" Margin="0,0,0,16" />
                <TextBlock TextWrapping="Wrap" FontSize="14" LineHeight="22">
                    LDAC A2DP Driver sends Bluetooth audio from Windows using AVDTP signaling,
                    the libldac encoder (AOSP, Apache 2.0) and SBC fallback.
                    <LineBreak /><LineBreak />
                    Settings for each device are stored here:
                </TextBlock>
                <TextBox IsReadOnly="True" Text="{Binding SettingsPath, Mode=OneWay}" Margin="0,8,0,0" />
                <TextBlock TextWrapping="Wrap" FontSize="14" Margin="0,16,0,0" Foreground="{StaticResource SecondaryText}">
                    The LdacA2dp driver provides the headphones output, volume and media controls.
                    LdacSvc encodes the audio. Its log is available here:
                    %ProgramData%\LdacA2dp\ldacsvc.log.
                </TextBlock>
            </StackPanel>

            <!-- FAQ -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding ShowFaq, Converter={StaticResource BoolToVis}}">
                <StackPanel Margin="20,24" MaxWidth="720" HorizontalAlignment="Left">
                    <TextBlock Text="FAQ" FontSize="28" Margin="0,0,0,16" />
                    <TextBlock FontWeight="SemiBold" FontSize="16" Text="Why is 96 kHz unavailable?" />
                    <TextBlock TextWrapping="Wrap" Margin="0,4,0,16" Foreground="{StaticResource SecondaryText}"
                               Text="Windows and the headphones negotiate the highest sample rate both allow. The headphones must advertise 96 kHz for LDAC." />
                    <TextBlock FontWeight="SemiBold" FontSize="16" Text="Why does HQ stutter?" />
                    <TextBlock TextWrapping="Wrap" Margin="0,4,0,16" Foreground="{StaticResource SecondaryText}"
                               Text="990 kbps needs a reliable Bluetooth connection. Enable adaptive bitrate or select SQ. Nearby 2.4 GHz Wi-Fi can also cause interference." />
                    <TextBlock FontWeight="SemiBold" FontSize="16" Text="Can I still use the headset for calls?" />
                    <TextBlock TextWrapping="Wrap" Margin="0,4,0,16" Foreground="{StaticResource SecondaryText}"
                               Text="Yes. Calls use the separate HFP driver. This package handles A2DP and AVRCP." />
                    <TextBlock FontWeight="SemiBold" FontSize="16" Text="Why is the start of a notification cut off?" />
                    <TextBlock TextWrapping="Wrap" Margin="0,4,0,16" Foreground="{StaticResource SecondaryText}"
                               Text="The headphones can take about a second to resume. Increase the time under Keep streaming after audio stops." />
                    <TextBlock FontWeight="SemiBold" FontSize="16" Text="What does Load defaults for this codec do?" />
                    <TextBlock TextWrapping="Wrap" Margin="0,4,0,16" Foreground="{StaticResource SecondaryText}"
                               Text="LDAC defaults to stereo, 44.1–96 kHz, 16 or 24 bits, SQ and adaptive bitrate. SBC defaults to stereo, 44.1 or 48 kHz and Joint Stereo." />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
